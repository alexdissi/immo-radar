{
  "name": "immo-radar-extension",
  "displayName": "Immo Radar",
  "version": "1.3.0",
  "description": "Connecteur Immo Radar : cherche sur Bien'ici, SeLoger, Logic-Immo, PAP et Leboncoin avec ta session de navigateur.",
  "private": true,
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "typecheck": "tsc --noEmit",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "plasmo": "0.90.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "^5.6.0"
  },
  "manifest": {
    "permissions": [
      "storage",
      "alarms",
      "notifications",
      "tabs"
    ],
    "host_permissions": [
      "https://www.bienici.com/*",
      "https://www.seloger.com/*",
      "https://www.pap.fr/*",
      "https://www.logic-immo.com/*",
      "https://www.leboncoin.fr/*",
      "http://localhost:3737/*"
    ]
  }
}
