# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: http://localhost:3737/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Supabase: transaction pooler (app runtime) and session pooler (migrations)
DATABASE_URL=
DIRECT_URL=
# openssl rand -base64 32 — encrypts Notion tokens at rest (AES-256-GCM)
ENCRYPTION_KEY=
# notion.so/profile/integrations → Public integration
# Redirect URI: http://localhost:3737/api/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
